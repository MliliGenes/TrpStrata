{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 8, "class_name": "launcher-card device-card brightness-card",
    "children": [
      {"type": "Row", "spacing": 8, "class_name": "device-header", "children": [
        {"type": "Text", "text": {"$bind": "state.title"}, "class_name": "widget-label", "align": "start", "expand": true, "key": "title"},
        {"type": "Text", "text": {"$bind": "state.level"}, "class_name": "device-level", "key": "level"}
      ]},
      {"type": "Slider", "value": {"$bind": "state.value"}, "label": {"$bind": "state.label"}, "events": {"change": "change"}, "sensitive": {"$bind": "state.available"}, "class_name": "device-slider", "key": "level-slider"},
      {"type": "Button", "text": {"$bind": "state.mute_label"}, "events": {"click": "mute"}, "sensitive": {"$bind": "state.available"}, "visible": {"$bind": "state.show_mute"}, "class_name": "device-toggle button-outline", "key": "mute"},
      {"type": "Text", "text": {"$bind": "state.error"}, "visible": {"$bind": "state.show_error"}, "wrap": true, "max_width_chars": 32, "align": "start", "class_name": "widget-status", "key": "error"}
    ]
  }
}
