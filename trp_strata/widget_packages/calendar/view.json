{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 4, "class_name": "calendar-card",
    "children": [
      {"type": "Text", "text": {"$bind": "state.month"}, "class_name": "widget-label", "align": "start"},
      {"type": "Text", "text": {"$bind": "state.day"}, "class_name": "calendar-day", "align": "start"},
      {
        "type": "Grid", "columns": ["1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr"], "spacing": 2,
        "children": [
          {"repeat": {"$bind": "state.cells"}, "key": "id", "template": {
            "type": "Text", "text": {"$bind": "item.text"}, "class_name": {"$bind": "item.class"}, "expand": true
          }}
        ]
      }
    ]
  }
}
