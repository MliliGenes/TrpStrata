{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 10, "class_name": "cleaner-card",
    "children": [
      {"type": "Text", "text": "HOME CLEANER", "class_name": "widget-label", "align": "start"},
      {"type": "Text", "text": {"$bind": "state.status"}, "wrap": true, "max_width_chars": 36, "align": "start", "class_name": "widget-status", "key": "status"},
      {"type": "Text", "text": "Close VS Code and Firefox first.", "wrap": true, "max_width_chars": 36, "align": "start", "class_name": "widget-hint"},
      {"type": "Row", "spacing": 8, "class_name": "cleaner-actions", "children": [
        {"type": "Button", "text": "Scan", "events": {"click": "scan"}, "sensitive": {"$bind": "state.enabled"}, "class_name": "button-outline", "expand": true, "key": "scan"},
        {"type": "Button", "text": "Clean caches", "events": {"click": "clean"}, "sensitive": {"$bind": "state.enabled"}, "class_name": "button-primary", "expand": true, "key": "clean"}
      ]}
    ]
  }
}
