{
  "version": 1,
  "view": {
    "type": "Column", "class_name": "gap-2 bg-transparent py-em-0.55 px-em-0.25 min-w-em-12",
    "visible": {"$bind": "state.visible"},
    "children": [
      {
        "type": "Text",
        "text": {"$bind": "state.hours"},
        "class_name": "text-em-6 font-medium text-primary"
      },
      {
        "type": "Text",
        "text": {"$bind": "state.minutes"},
        "class_name": "text-em-6 font-medium text-primary"
      },
      {"type": "Text", "text": {"$bind": "state.date"}, "class_name": "text-em-0.82 font-semibold tracking-widest text-primary pt-em-0.15", "visible": {"$bind": "state.show_date"}, "key": "date"}
    ]
  }
}
