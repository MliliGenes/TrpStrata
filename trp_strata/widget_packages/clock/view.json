{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 8, "class_name": "desktop-clock",
    "visible": {"$bind": "state.visible"},
    "children": [
      {
        "type": "Text",
        "text": {"$bind": "state.hours"},
        "class_name": "clock-hours"
      },
      {
        "type": "Text",
        "text": {"$bind": "state.minutes"},
        "class_name": "clock-minutes"
      },
  
      {"type": "Text", "text": {"$bind": "state.date"}, "class_name": "clock-date", "visible": {"$bind": "state.show_date"}, "key": "date"}
    ]
  }
}
