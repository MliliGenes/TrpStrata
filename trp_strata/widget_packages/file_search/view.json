{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 8, "class_name": "launcher-card file-search-card",
    "children": [
      {"type": "Row", "spacing": 8, "class_name": "file-search-header", "children": [
        {"type": "Text", "text": {"$bind": "state.title"}, "class_name": "widget-label", "align": "start", "expand": true},
        {"type": "Button", "text": "Refresh", "events": {"click": "reload"}, "sensitive": {"$bind": "state.can_refresh"}, "class_name": "button-outline", "key": "refresh"}
      ]},
      {"type": "Search", "text": {"$bind": "state.query"}, "events": {"change": "search"}, "placeholder": "Find files by name…", "class_name": "file-query", "key": "file-query"},
      {"type": "Column", "spacing": 6, "class_name": "file-results", "children": [
        {"repeat": {"$bind": "state.results"}, "key": "id", "template": {
          "type": "Column", "spacing": 2, "children": [
            {"type": "Button", "text": {"$bind": "item.name"}, "events": {"click": {"handler": "launch", "args": {"$bind": "item.id"}}}, "system_icon": {"$bind": "item.icon"}, "tooltip": {"$bind": "item.id"}, "class_name": "file-result button-secondary"},
            {"type": "Text", "text": {"$bind": "item.directory"}, "align": "start", "wrap": true, "max_width_chars": 36, "class_name": "file-search-path"}
          ]
        }}
      ]},
      {"type": "Text", "text": "Type a name, abbreviation or a few words from the path.", "visible": {"$bind": "state.show_hint"}, "wrap": true, "max_width_chars": 36, "align": "start", "class_name": "widget-hint", "key": "hint"},
      {"type": "Text", "text": {"$bind": "state.status"}, "wrap": true, "max_width_chars": 36, "align": "start", "class_name": "widget-status", "key": "status"}
    ]
  }
}
