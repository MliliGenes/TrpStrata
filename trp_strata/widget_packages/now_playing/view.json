{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 8, "class_name": "media-card",
    "children": [
      {"type": "Text", "text": "NOW PLAYING", "class_name": "widget-label", "key": "label"},
      {"type": "Image", "data": {"$bind": "state.artwork"}, "class_name": "media-artwork", "key": "artwork"},
      {"type": "Text", "text": {"$bind": "state.title"}, "wrap": true, "max_width_chars": 28, "class_name": "media-title", "key": "title"},
      {"type": "Text", "text": {"$bind": "state.artist"}, "visible": {"$bind": "state.show_artist"}, "wrap": true, "max_width_chars": 28, "key": "artist"},
      {"type": "Text", "text": {"$bind": "state.album"}, "visible": {"$bind": "state.show_album"}, "wrap": true, "max_width_chars": 28, "class_name": "media-detail", "key": "album"},
      {"type": "Row", "spacing": 8, "children": [
        {"repeat": {"$bind": "state.controls"}, "key": "id", "template": {
          "type": "Button", "text": {"$bind": "item.label"},
          "events": {"click": {"handler": "control", "args": {"$bind": "item.id"}}},
          "icon": {"$bind": "item.icon"}, "tooltip": {"$bind": "item.label"},
          "sensitive": {"$bind": "item.enabled"}, "expand": true, "class_name": "media-control"
        }}
      ]},
      {"type": "Text", "text": {"$bind": "state.status"}, "wrap": true, "max_width_chars": 28, "class_name": "media-detail", "key": "status"}
    ]
  }
}
