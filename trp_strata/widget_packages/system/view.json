{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 12, "class_name": "system-card",
    "children": [
      {"type": "Text", "text": "SYSTEM", "class_name": "widget-label", "align": "start"},
      {"repeat": {"$bind": "state.metrics"}, "key": "id", "template": {
        "type": "Column", "spacing": 5,
        "children": [
          {"type": "Row", "children": [
            {"type": "Text", "text": {"$bind": "item.id"}, "align": "start", "expand": true},
            {"type": "Text", "text": {"$bind": "item.text"}, "class_name": "metric-value"}
          ]},
          {"type": "Progress", "value": {"$bind": "item.value"}, "visible": {"$bind": "item.available"}}
        ]
      }}
    ]
  }
}
