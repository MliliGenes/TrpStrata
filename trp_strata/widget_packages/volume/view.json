{
  "version": 1,
  "view": {
    "type": "Column", "spacing": 10, "class_name": "launcher-card device-card",
    "children": [
      {"type": "Row", "spacing": 8, "children": [
        {"type": "Text", "text": {"$bind": "state.title"}, "class_name": "widget-label", "align": "start", "expand": true},
        {"type": "Text", "text": {"$bind": "state.level"}}
      ]},
      {"type": "Slider", "value": {"$bind": "state.value"}, "label": {"$bind": "state.label"}, "events": {"change": "change"}, "sensitive": {"$bind": "state.available"}, "key": "level"},
      {"type": "Button", "text": {"$bind": "state.mute_label"}, "events": {"click": "mute"}, "sensitive": {"$bind": "state.available"}, "visible": {"$bind": "state.show_mute"}},
      {"type": "Text", "text": {"$bind": "state.error"}, "visible": {"$bind": "state.show_error"}, "wrap": true, "max_width_chars": 32, "align": "start"}
    ]
  }
}
